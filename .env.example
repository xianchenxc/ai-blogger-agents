# Required for DeepSeek API
DEEPSEEK_API_KEY=

# Optional: default deepseek-chat (tool-calling). Avoid deepseek-reasoner as primary agent model.
XHS_MODEL=deepseek-chat

# Optional: LangGraph recursion limit per invoke (default 160, clamped 20–500). Raises GraphRecursionError ceiling.
# XHS_RECURSION_LIMIT=200

# Optional: filesystem backend root (defaults to package root)
# XHS_BACKEND_ROOT=

# Optional: long-term memory JSONL (defaults to data/memory/generations.jsonl under package root)
# XHS_MEMORY_PATH=

# Optional LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
