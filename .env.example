# Required for DeepSeek API
DEEPSEEK_API_KEY=

# Optional: default deepseek-chat (tool-calling). Avoid deepseek-reasoner as primary agent model.
XHS_MODEL=deepseek-chat

# Optional: LangGraph recursion limit per invoke (default 160, clamped 20–500). Raises GraphRecursionError ceiling.
# XHS_RECURSION_LIMIT=200

# Optional: filesystem backend root (defaults to package root)
# XHS_BACKEND_ROOT=

# Optional: long-term memory JSONL (defaults to data/memory/generations.jsonl under package root)
# XHS_MEMORY_PATH=

# Optional LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=

# Playwright (xhs_assets_render): install browser once after npm install
# npx playwright install chromium

# --- HTTP API (npm run dev:api / npm run start:api) ---
# API_PORT=3840
# Optional: require Authorization: Bearer <token> on all /api/v1 routes
# ADMIN_API_TOKEN=
# Comma-separated CORS origins for the admin UI dev server (default: http://localhost:5173,http://127.0.0.1:5173). Use * to allow any origin.
# CORS_ORIGIN=
# Max concurrent agent invocations per process (default 1, max 8)
# XHS_INVOCATION_CONCURRENCY=1

# --- Web dev (web/.env) ---
# VITE_API_PORT=3840
# VITE_DEV_PORT=5173
